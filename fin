import random
def get_diff_settings(choice):
    if choice == "1":
        return {"mode": "Easy", "range": 50, "attempts": 10}
    elif choice == "2":
        return {"mode": "Medium", "range": 100, "attempts": 7}
    elif choice == "3":
        return {"mode": "Hard", "range": 500, "attempts": 5}
    return None


def generate_number(max):
    return random.randint(1, max)
