import random
def get_diff_settings(choice):
    if choice == "1":
        return {"mode": "Easy", "range": 50, "attempts": 10}
    elif choice == "2":
        return {"mode": "Medium", "range": 100, "attempts": 7}
    elif choice == "3":
        return {"mode": "Hard", "range": 500, "attempts": 5}
    return None


def generate_number(max):
    return random.randint(1, max)

def is_valid_number(input):
    try:
        int(input)
        return True
    except ValueError:
        return False

def get_result(guess, target):
    if guess > target:
        return "Too high"
    elif guess < target:
        return "Too low"
    return "Correct"

def game():
    print("Select Difficulty:")
    print("1. Easy (1–50, 10 attempts)")
    print("2. Medium (1–100, 7 attempts)")
    print("3. Hard (1–500, 5 attempts)")
    settings = None
    while settings is None:
        choice = input("Enter choice options (1,2,3) : ")
        settings = get_diff_settings(choice)
        if settings is None:
            print("Not a choice. Try again.")
    guessed_correctly = False
    target = generate_number(settings["range"])
    attempts_left = settings["attempts"]
